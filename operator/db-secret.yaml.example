# =============================================================================
# Database credentials secret — referenced by the WildFlyServer CR
#
# Copy this file to db-secret.yaml and fill in real values.
# Do NOT commit db-secret.yaml to Git.
#
# In production, use OpenShift Secrets Store CSI Driver or External Secrets
# Operator to inject from HashiCorp Vault / AWS Secrets Manager / Azure KV.
# =============================================================================
apiVersion: v1
kind: Secret
metadata:
  name: eap-demo-db
  labels:
    app.kubernetes.io/name: eap-demo
    app.kubernetes.io/component: database
type: Opaque
stringData:
  host: <DB_HOST>
  port: "5432"
  database: <DB_NAME>
  username: <DB_USER>
  password: <DB_PASSWORD>
